<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OddiloveVybaveni.ViewModels"
             xmlns:v="clr-namespace:OddiloveVybaveni.Views"
             x:Class="OddiloveVybaveni.App"
             RequestedThemeVariant="Light">

    <Application.DataTemplates>
        <DataTemplate DataType="{x:Type vm:VybaveniListViewModel}">
            <v:VybaveniListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VybaveniDetailViewModel}">
            <v:VybaveniDetailView />
        </DataTemplate>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
