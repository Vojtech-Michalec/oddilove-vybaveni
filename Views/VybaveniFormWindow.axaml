<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OddiloveVybaveni.ViewModels"
        x:Class="OddiloveVybaveni.Views.VybaveniFormWindow"
        x:DataType="vm:VybaveniFormViewModel"
        Title="{Binding Title}"
        Width="440" Height="360"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="*,Auto" Margin="20">
        <StackPanel Grid.Row="0" Spacing="10">

            <!-- Název -->
            <TextBlock Text="Název *" FontWeight="SemiBold" />
            <TextBox Text="{Binding Nazev}" Watermark="Název vybavení" />
            <TextBlock Text="{Binding NazevError}" Foreground="Red" FontSize="12"
                       IsVisible="{Binding NazevError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <!-- Kategorie -->
            <TextBlock Text="Kategorie *" FontWeight="SemiBold" />
            <ComboBox ItemsSource="{Binding Kategorie}"
                      SelectedItem="{Binding SelectedKategorie}"
                      DisplayMemberBinding="{Binding Nazev}"
                      HorizontalAlignment="Stretch"
                      PlaceholderText="Vyberte kategorii…" />
            <TextBlock Text="{Binding KategorieError}" Foreground="Red" FontSize="12"
                       IsVisible="{Binding KategorieError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <!-- Počet kusů -->
            <TextBlock Text="Počet kusů *" FontWeight="SemiBold" />
            <TextBox Text="{Binding PocetKusu}" Watermark="1" />
            <TextBlock Text="{Binding PocetError}" Foreground="Red" FontSize="12"
                       IsVisible="{Binding PocetError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <!-- Popis -->
            <TextBlock Text="Popis" FontWeight="SemiBold" />
            <TextBox Text="{Binding Popis}"
                     Watermark="Volitelný popis…"
                     AcceptsReturn="True"
                     Height="60" />
        </StackPanel>

        <!-- Tlačítka -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,16,0,0">
            <Button Grid.Column="1"
                    Content="Uložit"
                    Command="{Binding SaveCommand}"
                    Margin="0,0,8,0"
                    HorizontalAlignment="Right" />
            <Button Grid.Column="2"
                    Content="Zrušit"
                    Command="{Binding CancelCommand}" />
        </Grid>
    </Grid>
</Window>
